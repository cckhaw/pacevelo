# Public app URL — used to build the Strava redirect_uri and invite links.
# In production, set this to your real domain (e.g. https://app.pacevelo.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Settings -> API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Used to
# provision employee accounts during the Strava OAuth callback.
SUPABASE_SERVICE_ROLE_KEY=

# Strava API (https://www.strava.com/settings/api)
# Authorization Callback Domain must match NEXT_PUBLIC_APP_URL's host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Slack (Phase 2+: automated leaderboard notifications)
# Per-company webhook URLs are stored in companies.slack_webhook_url instead.

# Stripe (Phase 2+: subscriptions/billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
