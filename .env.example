# Public app URL — used to build the Strava redirect_uri and invite links.
# In production, set this to your real domain (e.g. https://pacevelo.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres connection string (Vercel Storage -> Neon, or neon.tech directly).
# Use the pooled ("-pooler") connection string for serverless/edge usage.
DATABASE_URL=

# Random secret used to sign session cookies (jose/JWT). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Vercel Blob (company logo uploads). Set automatically when a Blob store
# is connected to the project on Vercel; for local dev, copy it from
# Project Settings -> Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN=

# Strava API (https://www.strava.com/settings/api)
# Authorization Callback Domain must match NEXT_PUBLIC_APP_URL's host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# A secret string you choose yourself, used only to verify that webhook
# subscription requests to /api/webhooks/strava really came from Strava's
# subscription-creation handshake (see README for setup). Generate one with:
#   openssl rand -hex 20
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Base URL for Strava's REST API. Leave unset to use the current
# https://www.strava.com/api/v3. Strava is moving it to
# https://api-v3.strava.com, available from 2027-01-04 (the host doesn't
# exist before then, so don't set it early). After that date, confirm the new
# host answers, then set this and redeploy. Sign-in/token URLs aren't affected.
STRAVA_API_BASE_URL=

# The `id` Strava returns when the push subscription is created (see README).
# Strava doesn't sign webhook payloads, so when this is set, events from any
# other subscription id are rejected. Optional, but recommended.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# How many days after an athlete's last challenge ended (or after they
# connected, if they never joined one) before /api/cron/cleanup-strava
# revokes their Strava connection so they stop counting against the app's
# connected-athlete capacity. Defaults to 7. That cron requires CRON_SECRET
# (below) and supports ?dryRun=1 to preview who it would revoke.
STRAVA_STALE_AFTER_DAYS=

# How many days after a challenge ends before /api/cron/cleanup-strava deletes
# the synced Strava activities credited to it (the privacy policy and the
# Strava consent notice show this same number). Defaults to 30.
STRAVA_DATA_RETENTION_DAYS=

# Google Health API (https://developers.google.com/health) - OAuth client
# for challenges that rank participants by daily step count instead of
# Strava activities. Create an OAuth 2.0 client (type "Web application") in
# Google Cloud Console; its authorized redirect URI must be
# {NEXT_PUBLIC_APP_URL}/api/auth/google-health/callback. New clients are
# capped at 100 test users until Google verifies the app.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# A secret string you choose yourself, used to authorize Vercel Cron's
# requests to /api/cron/sync-google-health (which pulls fresh step data for
# every connected profile - Google Health has no webhook push like Strava's)
# and /api/cron/cleanup-strava (which refuses to run without it).
# Vercel sets this automatically as the cron job's bearer token when the env
# var is present. Generate one with:
#   openssl rand -hex 20
CRON_SECRET=

# Resend (https://resend.com/api-keys) - sends the email OTP participants
# verify with when joining a challenge via its invite link, and the
# /contact form's enquiry email.
RESEND_API_KEY=
# Must be on a domain you've verified with Resend; the shared resend.dev
# sandbox address only delivers to your own Resend account email.
RESEND_FROM_EMAIL="PaceVelo <noreply@yourdomain.com>"

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) - captcha
# on the public /contact form. Create a widget there; NEXT_PUBLIC_ is the
# widget's Site Key (safe to expose client-side), the other is its Secret
# Key (server-side only, used to verify submitted tokens).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Back office (/backoffice) - internal PaceVelo staff login for viewing all
# companies/challenges/participants and managing onboarding codes + company
# plan limits. Not tied to any company account.
BACKOFFICE_USERNAME=
BACKOFFICE_PASSWORD=

# One-time setup, optional: the iCloud share link for the reusable "Report
# Steps to PaceVelo" Apple Shortcut (see lib/ios-shortcut.ts and
# /dashboard/devices). Build the shortcut once on a real iPhone per that
# file's recipe, share it via the Shortcuts app's Share Sheet -> Copy iCloud
# Link, and paste that link here - the same shortcut then works for every
# employee via a per-user "connect" deep link, no per-employee manual setup.
# Leave unset and the dashboard shows manual build-it-yourself instructions
# instead.
NEXT_PUBLIC_IOS_SHORTCUT_ICLOUD_URL=

# One-time setup, optional: the iCloud share link for a pre-built Personal
# Automation that runs the shortcut above whenever WhatsApp / WhatsApp
# Business is opened (App -> Is Opened -> Run Shortcut "Report Steps to PaceVelo", with Ask Before
# Running turned off). Build it once in the Shortcuts app's Automation tab,
# then long-press it -> Share -> Copy iCloud Link, same as the shortcut
# itself. Adds a third "turn on automatic sync" tap to the setup flow; leave
# unset and employees set up the automation by hand instead (still covered
# in the manual instructions).
#
# Apple always imports a shared Personal Automation switched OFF, regardless
# of how the original was configured - there's no share-link parameter or
# API to override this, so each employee has to tap the "Automation is
# turned off" banner themselves after adding it. The dashboard's
# instructions already call this out; it isn't a bug in this setup.
NEXT_PUBLIC_IOS_SHORTCUT_AUTOMATION_ICLOUD_URL=

# One-time setup, optional: public download URL for the sideloaded Android
# companion app's debug .apk (see android-app/README.md and
# lib/android-apk.ts). The .apk itself is committed at
# public/downloads/pacevelo-steps.apk, so Vercel serves it as a static file
# of this same deployment - just set this to
# `https://<your-domain>/downloads/pacevelo-steps.apk`. To ship a rebuilt
# .apk later, replace that file (`./gradlew assembleDebug` in android-app/,
# then overwrite public/downloads/pacevelo-steps.apk) and redeploy - the URL
# doesn't change. Leave this env var unset and the dashboard shows a
# "coming soon" placeholder instead.
NEXT_PUBLIC_ANDROID_APK_URL=

# Slack (Phase 2+: automated leaderboard notifications)
# Per-company webhook URLs are stored in companies.slack_webhook_url instead.

# Stripe (Phase 2+: subscriptions/billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
